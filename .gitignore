# Python cache / build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large binary media — keep original video local only, do not commit
*.MP4
*.mp4
*.mov
*.mkv

# Derived evidence media (regenerate with evidence/prepare_evidence.py from the local video)
golden_episode/*/evidence/clips/

# Deliverable bundles (archived copies live under archive/)
*.zip

# Temp / editor / OS files
*.tmp
*.bak
*~
~$*
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local environments
.venv/
venv/
.env

# V2 model runs include raw responses, frame samples, and local usage records
golden_episode/*/annotations/v2_video_model/runs/
