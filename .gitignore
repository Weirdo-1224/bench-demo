# Python cache / build artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large binary media — keep original video local only, do not commit
*.MP4
*.mp4
*.mov
*.mkv

# Derived evidence media (regenerate with evidence/prepare_evidence.py from the local video)
golden_episode/*/evidence/clips/

# Experiment derived media — frame dumps extractable from the local source video
experiments/*/inputs/
experiments/*/review_frames/
experiments/*/runs/**/frames/

# Experiment raw API artifacts and local usage records (parsed output lives in checkpoint.json)
experiments/*/runs/**/attempt-*.response.json
experiments/*/runs/**/request.json
experiments/*/runs/**/*.request.json
experiments/*/request_ledger/

# _showcase_export media frames and source snapshots are 1:1 copies of golden_episode content
_showcase_export/*/media/frames/
_showcase_export/*/source_snapshots/

# Deliverable bundles (archived copies live under archive/)
*.zip

# Temp / editor / OS files
*.tmp
*.bak
*~
~$*
*.log
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local environments
.venv/
venv/
.env

# V2 model runs include raw responses, frame samples, and local usage records
golden_episode/*/annotations/v2_video_model/runs/

# Annotation pipeline local credentials / baselines / config
*.local.json
config.local.yaml
