{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GX010021 candidate consolidation v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "./schema.json"
        },
        "schema_version": {
          "const": "1.0"
        },
        "episode_id": {
          "const": "GX010021"
        },
        "artifact": {
          "const": "events"
        },
        "data_status": {
          "const": "CANDIDATE"
        },
        "human_review": {
          "const": "NOT_REVIEWED"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "video_metadata_only",
                  "ego_mc_text_only",
                  "archived_ai_report"
                ]
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes",
              "role",
              "priority"
            ],
            "additionalProperties": false
          }
        },
        "video": {
          "type": "object",
          "properties": {
            "path": {
              "const": "source/GX010021.MP4"
            },
            "duration_sec": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "metadata_method": {
              "type": "string"
            },
            "video_stream": {
              "type": "object"
            },
            "reported_evidence_range": {
              "$ref": "#/$defs/time"
            },
            "reported_sampling_fps": {
              "const": 1
            },
            "sampling_verified": {
              "const": false
            },
            "uncovered_tail_sec": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "path",
            "duration_sec",
            "metadata_method",
            "video_stream",
            "reported_evidence_range",
            "reported_sampling_fps",
            "sampling_verified",
            "uncovered_tail_sec"
          ],
          "additionalProperties": false
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 56,
          "maxItems": 56
        },
        "ego_mc_records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ego_mc_record"
          },
          "minItems": 55,
          "maxItems": 55
        },
        "statistics": {
          "type": "object"
        }
      },
      "required": [
        "$schema",
        "schema_version",
        "episode_id",
        "artifact",
        "data_status",
        "human_review",
        "sources",
        "video",
        "limitations",
        "evidence",
        "events",
        "ego_mc_records",
        "statistics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "./schema.json"
        },
        "schema_version": {
          "const": "1.0"
        },
        "episode_id": {
          "const": "GX010021"
        },
        "artifact": {
          "const": "objects"
        },
        "data_status": {
          "const": "CANDIDATE"
        },
        "human_review": {
          "const": "NOT_REVIEWED"
        },
        "evidence_registry": {
          "const": "events.json#/evidence"
        },
        "identity_policy": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "statistics": {
          "type": "object"
        }
      },
      "required": [
        "$schema",
        "schema_version",
        "episode_id",
        "artifact",
        "data_status",
        "human_review",
        "evidence_registry",
        "identity_policy",
        "objects",
        "statistics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "./schema.json"
        },
        "schema_version": {
          "const": "1.0"
        },
        "episode_id": {
          "const": "GX010021"
        },
        "artifact": {
          "const": "review_queue"
        },
        "data_status": {
          "const": "CANDIDATE"
        },
        "human_review": {
          "const": "NOT_REVIEWED"
        },
        "priority_policy": {
          "type": "string"
        },
        "review_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review_item"
          }
        },
        "statistics": {
          "type": "object"
        }
      },
      "required": [
        "$schema",
        "schema_version",
        "episode_id",
        "artifact",
        "data_status",
        "human_review",
        "priority_policy",
        "review_items",
        "statistics"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "time": {
      "type": "object",
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0
        },
        "end_sec": {
          "type": "number",
          "minimum": 0
        },
        "start_hms": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
        },
        "end_hms": {
          "type": "string",
          "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"
        }
      },
      "required": [
        "start_sec",
        "end_sec",
        "start_hms",
        "end_hms"
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "value": {},
        "status": {
          "enum": [
            "REPORTED_SUPPORTED",
            "UNCERTAIN"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "field",
        "value",
        "status",
        "evidence_ids",
        "reason"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "before": {},
        "after": {},
        "reason": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "field",
        "before",
        "after",
        "reason",
        "source"
      ],
      "additionalProperties": false
    },
    "event_original": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "start_time": {
          "type": "string"
        },
        "end_time": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "state_change": {
          "type": "string"
        },
        "certainty": {
          "type": "string"
        },
        "raw_row": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "id",
        "start_time",
        "end_time",
        "action",
        "actor",
        "target",
        "description",
        "state_change",
        "certainty",
        "raw_row",
        "source"
      ],
      "additionalProperties": false
    },
    "object_original": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "time_range": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "before": {
          "type": "string"
        },
        "after": {
          "type": "string"
        },
        "event_ids_text": {
          "type": "string"
        },
        "raw_row": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "id",
        "name",
        "time_range",
        "operation",
        "before",
        "after",
        "event_ids_text",
        "raw_row",
        "source"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "original_claim_status": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "UNCERTAIN"
          ]
        },
        "current_claim_status": {
          "enum": [
            "REPORTED_SUPPORTED",
            "CORRECTED_CANDIDATE",
            "UNCERTAIN"
          ]
        },
        "human_status": {
          "const": "NOT_REVIEWED"
        },
        "report_row": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "verdict": {
              "type": "string"
            },
            "time_accuracy": {
              "type": "string"
            },
            "action_accuracy": {
              "type": "string"
            },
            "state_accuracy": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            },
            "recommendation": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "verdict",
            "time_accuracy",
            "action_accuracy",
            "state_accuracy",
            "evidence",
            "recommendation"
          ],
          "additionalProperties": false
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "raw_row": {
          "type": "string"
        }
      },
      "required": [
        "original_claim_status",
        "current_claim_status",
        "human_status",
        "report_row",
        "source",
        "raw_row"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "reported_visual_observation",
            "model_inference",
            "inherited_candidate_text",
            "ego_mc_text"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "description": {
          "type": "string"
        },
        "grade": {
          "enum": [
            "V1",
            "V2",
            "T",
            "TEXT"
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "original_text": {
          "type": "string"
        },
        "normalization_source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "id",
        "kind",
        "source",
        "description",
        "grade"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E\\d{3}$"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "time_status": {
          "const": "APPROXIMATE"
        },
        "action": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "original_candidate": {
          "$ref": "#/$defs/event_original"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "state_change_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ego_mc_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          }
        }
      },
      "required": [
        "id",
        "time",
        "time_status",
        "action",
        "actor",
        "description",
        "object_ids",
        "original_candidate",
        "verification",
        "facts",
        "state_change_ids",
        "evidence_ids",
        "ego_mc_record_ids",
        "revisions"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "temporal_role": {
          "enum": [
            "during",
            "aftermath"
          ]
        },
        "kind": {
          "enum": [
            "transition",
            "observation"
          ]
        },
        "field": {
          "type": "string"
        },
        "before": {},
        "after": {},
        "status": {
          "enum": [
            "REPORTED_SUPPORTED",
            "UNCERTAIN"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "event_id",
        "time",
        "temporal_role",
        "kind",
        "field",
        "before",
        "after",
        "status",
        "evidence_ids",
        "reason"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^O\\d{2}$"
        },
        "name": {
          "type": "string"
        },
        "identity_status": {
          "enum": [
            "CANDIDATE",
            "GROUP",
            "UNRESOLVED_OBSERVATION"
          ]
        },
        "original_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/object_original"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string"
        },
        "identity_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "object_id": {
                "type": "string"
              },
              "relation": {
                "const": "SAME_AS_UNKNOWN"
              },
              "evidence_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "object_id",
              "relation",
              "evidence_ids",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "state_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "revisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/revision"
          }
        }
      },
      "required": [
        "id",
        "name",
        "identity_status",
        "original_candidate",
        "summary",
        "identity_relations",
        "facts",
        "event_ids",
        "state_history",
        "revisions"
      ],
      "additionalProperties": false
    },
    "ego_mc_record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R\\d{2}$"
        },
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "text_type": {
          "enum": [
            "Instruction",
            "User-Comment",
            "Success",
            "Feedback",
            "Instruction-Clarification",
            "User-Question"
          ]
        },
        "time": {
          "$ref": "#/$defs/time"
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "alignment": {
          "type": "string"
        },
        "mapping_context": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "mapping_source": {
          "$ref": "#/$defs/source"
        },
        "mapping_raw_row": {
          "type": "string"
        },
        "evidence_id": {
          "type": "string"
        },
        "use": {
          "const": "TEXT_CLUE_ONLY"
        }
      },
      "required": [
        "id",
        "source_index",
        "text",
        "text_type",
        "time",
        "event_ids",
        "alignment",
        "mapping_context",
        "notes",
        "mapping_source",
        "mapping_raw_row",
        "evidence_id",
        "use"
      ],
      "additionalProperties": false
    },
    "review_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RQ\\d{2}$"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "status": {
          "const": "OPEN"
        },
        "title": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "time_ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time"
          }
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "object_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ego_mc_record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "artifact": {
                "enum": [
                  "events",
                  "objects"
                ]
              },
              "record_id": {
                "type": "string"
              },
              "field": {
                "type": "string"
              }
            },
            "required": [
              "artifact",
              "record_id",
              "field"
            ],
            "additionalProperties": false
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "review_method": {
          "type": "string"
        },
        "priority_notes": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "priority",
        "status",
        "title",
        "question",
        "time_ranges",
        "event_ids",
        "object_ids",
        "ego_mc_record_ids",
        "targets",
        "evidence_ids",
        "sources",
        "review_method",
        "priority_notes"
      ],
      "additionalProperties": false
    }
  }
}
